
<script id="strict-auth-check">
(function () {
  function hideUntilLoggedIn() {
    document.body.classList.remove('admin-authenticated');
  }
  hideUntilLoggedIn();

  var tries = 0;
  var timer = setInterval(function () {
    tries++;
    if (typeof db !== 'undefined' && db.auth) {
      clearInterval(timer);
      db.auth.getSession().then(function (r) {
        var session = r && r.data && r.data.session;
        document.body.classList.toggle('admin-authenticated', !!session);
        if (!session) {
          var selectors = ['#adminApp','#dashboard','#savedData','.admin-content','.dashboard','.case-list','.applications'];
          selectors.forEach(function(s){
            document.querySelectorAll(s).forEach(function(el){ el.innerHTML=''; });
          });
        }
      });
      db.auth.onAuthStateChange(function (_event, session) {
        document.body.classList.toggle('admin-authenticated', !!session);
        if (!session) location.reload();
      });
    }
    if (tries > 50) clearInterval(timer);
  }, 100);
})();
</script>
